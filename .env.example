# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# API key Hostelworld's own frontend sends to their Apigee-fronted
# destination-suggest endpoint. Obtained by inspecting a real request in
# browser DevTools (Network tab -> autocomplete request -> Request
# Headers -> "api-key"). This key ships in Hostelworld's own public
# frontend bundle to every visitor's browser, but is still handled as an
# env var rather than hardcoded, since it can rotate and this is correct
# practice regardless of sensitivity.
HOSTELWORLD_AUTOCOMPLETE_API_KEY=

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info

# Server-side kill switch for "Detailed Mode" (exact per-hostel pricing
# — see DetailedModeToggle.tsx). Detailed Mode is now a per-request
# choice the user makes in the UI, not a server default — this variable
# only exists to hard-disable the option entirely on a given deployment
# (e.g. if even the 5-city cap turns out to be too much for your
# hosting's time limits). Unset or 'true' = allowed (default). Set to
# 'false' to disable the toggle everywhere, client and server both.
ALLOW_DETAILED_MODE=true
